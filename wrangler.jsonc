{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openreach",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "STORE", "class_name": "OpenReachStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["OpenReachStore"] }
  ],
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "openreach.niche.tech",
      "custom_domain": true
    }
  ]
}
