# Optional on a deployed host. Locally, the UI asks for the key first and
# stores it in data/typesafe.key (gitignored). Env wins over that file.
TYPESAFE_API_KEY=

# Optional: higher Semantic Scholar rate limits
# SEMANTIC_SCHOLAR_API_KEY=

# Optional: polite OpenAlex contact (defaults to local placeholder)
# OPENALEX_MAILTO=you@example.com

# Web/API port (default 3000). Set API_ONLY=1 to skip serving web/dist.
# PORT=3000
