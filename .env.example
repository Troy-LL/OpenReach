# Optional locally. The UI asks for the key first and keeps it in the browser.
# `npm run dev` / Docker may also write data/typesafe.key (gitignored). Env wins
# over that file. Do not set TYPESAFE_API_KEY as a Cloudflare Worker secret —
# hosted OpenReach does not store visitor keys on the server.
TYPESAFE_API_KEY=

# Optional: higher Semantic Scholar rate limits
# SEMANTIC_SCHOLAR_API_KEY=

# Optional: polite OpenAlex contact (defaults to local placeholder)
# OPENALEX_MAILTO=you@example.com

# Web/API port (default 3000). Set API_ONLY=1 to skip serving web/dist.
# PORT=3000
